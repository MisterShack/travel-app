# Local development configuration. Copy to `.env.local` (gitignored) and edit.
# The server loads it via `node --env-file-if-exists=.env.local`.
#
# Production values live in Railway's variable store, never in a file — see
# DEPLOY.md §3. This file documents the shape, not the secrets.

NODE_ENV=development
PORT=8787

# libSQL/SQLite URL. `file:` for a local file, `libsql:` for Turso.
# In the container this is set to file:/data/travel.db by the Dockerfile.
DATABASE_URL=file:./data/travel.db

# Cross-origin allow-list. Comma-separated, and each entry needs its scheme —
# `localhost:5173` parses as scheme "localhost:" and would silently match no
# real Origin header, so it is rejected at boot.
APP_ORIGIN=http://localhost:5173,http://localhost:4173

# Public base URL of this API, used to build links in email.
PUBLIC_URL=http://localhost:8787

# Directory of the built client. Unset in development, where Vite serves the
# client on its own port. Must be ABSOLUTE when set: Hono's serveStatic resolves
# it against the process cwd, so a relative path silently 404s the whole client
# depending on where the process was launched from. The Dockerfile sets
# /app/app/dist.
# STATIC_DIR=/absolute/path/to/app/dist

# Set only when a known proxy rewrites x-forwarded-for. Off locally so the rate
# limiter (Phase 2) cannot be spoofed by a header.
TRUST_PROXY=false
