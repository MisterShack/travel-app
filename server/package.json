{
  "name": "@travel/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=.env.local --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.0",
    "@libsql/client": "^0.17.0",
    "@node-rs/argon2": "^2.0.0",
    "@travel/shared": "*",
    "@types/web-push": "^3.6.4",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.6.0",
    "tsx": "^4.19.0",
    "web-push": "^3.6.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
