{
  "name": "travel-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "shared",
    "app",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @travel/app",
    "dev:server": "npm run dev --workspace @travel/server",
    "preview": "npm run preview --workspace @travel/app",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present && npm run test:infra",
    "test:infra": "node --test \"infra/*.test.mjs\"",
    "check-drift": "node infra/check-drift.mjs",
    "coverage": "npm run coverage --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.28.2",
    "@libsql/linux-x64-gnu": "0.5.29",
    "@node-rs/argon2-linux-x64-gnu": "2.1.0",
    "@rolldown/binding-linux-x64-gnu": "1.2.4",
    "@rolldown/binding-win32-x64-msvc": "1.2.4",
    "lightningcss-linux-x64-gnu": "1.33.0",
    "lightningcss-win32-x64-msvc": "1.33.0"
  }
}
