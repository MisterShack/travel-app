---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';

const title = 'Wayleaf — every trip should end with a book';
const description =
  'Wayleaf pools everyone’s trip photos, sorts them by the day and place they were taken, and turns them into a printed book. Coming soon for iPhone and Android.';
---
<Base title={title} description={description}>
  <a class="skip" href="#main">Skip to content</a>

  <header class="bar">
    <span class="wordmark"><Mark size={26} title="Wayleaf" />Wayleaf</span>
    <span class="soon">Coming&nbsp;soon</span>
  </header>

  <main id="main">
    <section class="hero">
      <h1>Every trip should end with a book.</h1>
      <p class="lede">
        The photos are on five different phones. The good ones are buried under
        eight near-identical shots of the same cathedral. Nobody makes the album,
        because making the album is four hours of work.
      </p>
      <p class="lede">
        Wayleaf collects everyone’s photos, sorts them by the day and the place
        they were actually taken, and turns them into something you can hold.
      </p>

      <form class="signup" method="post" action="/api/waitlist">
        <label for="email">Get an email when it opens</label>
        <div class="field">
          <input
            id="email" name="email" type="email" required autocomplete="email"
            inputmode="email" placeholder="you@example.com" spellcheck="false"
          />
          <button type="submit">Keep me posted</button>
        </div>
        <p class="fineprint">
          Your address, used once, to tell you when Wayleaf opens. Nothing else,
          nobody else, and you can ask us to delete it any time.{' '}
          <a href="/privacy/">What we do with it</a>.
        </p>
      </form>
    </section>

    <section class="what" aria-labelledby="what-h">
      <h2 id="what-h">Plan it, live it, keep it</h2>
      <ol class="three">
        <li>
          <h3>Plan it</h3>
          <p>
            Forward your confirmations. Flights, trains, hotels, the dinner
            reservation — they become one timeline, each in its own time zone,
            readable on a plane with no signal.
          </p>
        </li>
        <li>
          <h3>Live it</h3>
          <p>
            Everyone on the trip adds their photos. No accounts to chase, no
            albums to merge afterwards, and nobody has to pay to join in.
          </p>
        </li>
        <li>
          <h3>Keep it</h3>
          <p>
            The album puts itself together — day by day, place by place, the
            best shot of each moment picked out. You approve it. We print it.
          </p>
        </li>
      </ol>
    </section>

    <section class="expect" aria-labelledby="expect-h">
      <h2 id="expect-h">What to expect</h2>
      <ul class="plain">
        <li><strong>A phone app first.</strong> iPhone to begin with, Android close behind. Photos live on your phone, so that is where this belongs.</li>
        <li><strong>Free for everyone on the trip.</strong> The people who just add photos never see a bill. That is not a trial — it is how it works.</li>
        <li><strong>You pay when you want the book.</strong> No subscription to use it, no paywall in front of the part that matters.</li>
        <li><strong>Already been on the trip?</strong> That works too. Give us a date range and a destination and we will build the album from the photos you already have.</li>
        <li><strong>Your photos are not the product.</strong> We do not sell them, we do not train on them, and location data is stripped from anything you share.</li>
      </ul>
    </section>

    <section class="who" aria-labelledby="who-h">
      <h2 id="who-h">Who it is for</h2>
      <p class="lede">
        The person in the house who books the trip, chases everyone for their
        photos afterwards, and ends up making the album alone. You already do
        the work. This is for doing less of it.
      </p>
    </section>
  </main>

  <footer class="foot">
    <p class="tag"><Mark size={18} />Leaf through it.</p>
    <nav aria-label="Footer">
      <a href="/privacy/">Privacy</a>
      <a href="mailto:hello@wayleaf.app">hello@wayleaf.app</a>
    </nav>
    <p class="small">Wayleaf is in development. Nothing is available to buy yet.</p>
  </footer>
</Base>

<style>
  .skip {
    position: absolute; left: -9999px; top: 0; z-index: 10;
    background: var(--surface); color: var(--ink);
    padding: 0.6rem 1rem; border-radius: 0 0 6px 0;
  }
  .skip:focus { left: 0; }

  .bar {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; padding: 1.4rem var(--gutter);
    max-width: 62rem; margin: 0 auto;
  }
  .wordmark {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-family: var(--display); font-weight: 500; font-size: 1.4rem;
    font-variation-settings: 'SOFT' 40, 'WONK' 1;
    letter-spacing: -0.02em; color: var(--accent);
  }
  .soon {
    font-size: 0.8125rem; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--ink-muted); border: 1px solid var(--hairline);
    border-radius: 999px; padding: 0.3rem 0.75rem; white-space: nowrap;
  }

  main { max-width: 62rem; margin: 0 auto; padding: 0 var(--gutter); }

  section { padding-block: clamp(2.5rem, 7vw, 4.5rem); }
  section + section { border-top: 1px solid var(--hairline); }

  h1 {
    font-size: clamp(2.4rem, 7.5vw, 4rem);
    max-width: 16ch; margin-bottom: 1.5rem;
  }
  h2 { font-size: clamp(1.5rem, 3.4vw, 2rem); margin-bottom: 1.75rem; }
  h3 { font-size: 1.1875rem; margin-bottom: 0.5rem; }

  .lede { max-width: var(--measure); color: var(--ink-muted); font-size: 1.125rem; }
  .lede + .lede { margin-top: 1rem; }

  .signup { margin-top: 2.5rem; max-width: var(--measure); }
  .signup label { display: block; font-weight: 500; margin-bottom: 0.6rem; }
  .field { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  input[type='email'] {
    flex: 1 1 15rem; min-width: 0;
    font: inherit; color: var(--ink); background: var(--surface);
    border: 1px solid var(--edge); border-radius: 8px;
    padding: 0.7rem 0.85rem;
  }
  input::placeholder { color: var(--ink-muted); opacity: 0.8; }
  button {
    font: inherit; font-weight: 500; cursor: pointer;
    color: var(--ground); background: var(--accent);
    border: 1px solid var(--accent); border-radius: 8px;
    padding: 0.7rem 1.15rem;
  }
  button:hover { background: var(--ink); border-color: var(--ink); }
  button:active { transform: translateY(1px); }
  .fineprint { margin-top: 0.85rem; font-size: 0.9375rem; color: var(--ink-muted); }

  .three { list-style: none; padding: 0; margin: 0; display: grid; gap: 2rem; }
  @media (min-width: 46rem) { .three { grid-template-columns: repeat(3, 1fr); gap: 2.25rem; } }
  .three p { color: var(--ink-muted); }

  .plain { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.1rem; max-width: 44rem; }
  .plain li { color: var(--ink-muted); padding-left: 1.4rem; position: relative; }
  .plain strong { color: var(--ink); font-weight: 500; }
  .plain li::before {
    content: ''; position: absolute; left: 0; top: 0.62em;
    width: 0.5rem; height: 0.5rem; border-radius: 50%;
    background: var(--accent-wash);
  }

  .foot {
    max-width: 62rem; margin: 0 auto;
    padding: 2.5rem var(--gutter) 3.5rem;
    border-top: 1px solid var(--hairline);
    display: grid; gap: 0.9rem;
  }
  .tag {
    display: inline-flex; align-items: center; gap: 0.45rem;
    font-family: var(--display); font-size: 1.125rem; color: var(--accent);
    font-variation-settings: 'SOFT' 40, 'WONK' 1;
  }
  .foot nav { display: flex; gap: 1.25rem; flex-wrap: wrap; }
  .small { font-size: 0.9375rem; color: var(--ink-muted); }
</style>
