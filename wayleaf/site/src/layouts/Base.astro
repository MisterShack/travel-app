---
import '../styles/tokens.css';

interface Props { title: string; description: string; noindex?: boolean; }
const { title, description, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;

/**
 * Structured data. `SoftwareApplication` is deliberately absent until there is
 * an app to install — describing an unreleased product as installable software
 * is the kind of small dishonesty search engines are good at noticing, and it
 * would have to be unpicked later.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Wayleaf',
  url: 'https://wayleaf.app',
  description,
  slogan: 'Leaf through it.',
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Wayleaf" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#FAF7F2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1A1917" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!--
      Fonts are on Google's CDN for now with a real fallback stack, so the page
      is correct before they load and correct if they never do.
      TODO before launch: self-host. German courts have found embedding Google
      Fonts to transmit a visitor's IP without consent, which is a poor look for
      a product whose pitch includes not being careless with your data.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500&family=Inter:wght@400;500&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
